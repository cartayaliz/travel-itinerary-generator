### CP01: Aprobación exitosa de itinerario
### ==========================================
POST {{HostAddress}}/api/validaciones
Content-Type: application/json

{
  "estado": 1,
  "observaciones": "Itinerario aprobado sin observaciones.",
  "itinerarioID": 2,
  "jefeID": 2
}

### ==========================================
### CP02: Aprobación exitosa de itinerario
### ==========================================
POST {{HostAddress}}/api/validaciones/jefes/2/validar
Content-Type: application/json

{
  "estado": 1,
  "observaciones": "Itinerario aprobado sin observaciones.",
  "itinerarioID": 10
}
### ==========================================
### CP02: Rechazo exitoso de itinerario
### ==========================================
POST {{HostAddress}}/api/validaciones/jefes/2/validar
Content-Type: application/json

{
  "estado": 2,
  "observaciones": "Itinerario rechazado.",
  "itinerarioID": 10
}