@HostAddress = http://0.0.0.0:5064

### 1. Crear un Turista (ID esperado: 1)
POST {{HostAddress}}/api/usuarios
Content-Type: application/json

{
  "nombre": "Ana Turista",
  "password": "password123",
  "tipoUsuario": 2,
  "especialidad": null,
  "edad": 25,
  "grupoID": 1
}

### 2. Crear un Guía (ID esperado: 2)
POST {{HostAddress}}/api/usuarios
Content-Type: application/json

{
  "nombre": "Carlos Guía",
  "password": "password123",
  "tipoUsuario": 1,
  "especialidad": "Historia",
  "edad": null,
  "grupoID": null
}

### 3. Asignar Paquetes al Turista (ID 1)
# Ojo: Paquete ID 1 debe existir
POST {{HostAddress}}/api/usuarios/1/paquetes
Content-Type: application/json

[
  { "paqueteID": 1 }
]

### 4. Asignar Paquetes Autorizados al Guía (ID 2)
# Ojo: Paquete ID 1 debe existir
POST {{HostAddress}}/api/usuarios/2/paquetes-autorizados
Content-Type: application/json

[
  { "paqueteID": 1 }
]

### 5. Obtener todos los usuarios 
GET {{HostAddress}}/api/usuarios
Accept: application/json